import sys
 
input = sys.stdin.readline
 
t = int(input())
 
for _ in range(t):
    n, k = map(int, input().split())
 
    p = [0] * n
    cur = 1
 
    # k, 2k, 3k, ... 위치에 작은 수부터 배치
    for pos in range(k - 1, n, k):
        p[pos] = cur
        cur += 1
 
    # 남은 자리는 큰 수들로 채우기
    for i in range(n):
        if p[i] == 0:
            p[i] = cur
            cur += 1
 
    print(*p)
