import sys
from collections import Counter
 
input = sys.stdin.readline
 
t = int(input())
 
for _ in range(t):
    n = int(input())
    s = list(input().strip())
 
    cnt = Counter(s)
 
    if len(cnt) == 1:
        print(''.join(s))
        continue
 
    # 가장 많이 나온 문자
    max_char = max(cnt, key=lambda c: cnt[c])
 
    # 가장 적게 나온 문자
    # 단, max_char와 다른 문자여야 함
    min_char = min(
        [c for c in cnt if c != max_char],
        key=lambda c: cnt[c]
    )
 
    # min_char 하나를 max_char로 바꾸기
    for i in range(n):
        if s[i] == min_char:
            s[i] = max_char
            break
 
    print(''.join(s))
