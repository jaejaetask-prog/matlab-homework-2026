import sys
 
input = sys.stdin.readline
 
t = int(input())
 
for _ in range(t):
    n = int(input())
    a = list(map(int, input().split()))
 
    prefix_sum = 0
    answer = []
    min_height = float('inf')
 
    for i in range(n):
        prefix_sum += a[i]
        min_height = min(min_height, prefix_sum // (i + 1))
        answer.append(str(min_height))
 
    print(" ".join(answer))
