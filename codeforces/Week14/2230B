import sys
 
input = sys.stdin.readline
 
t = int(input())
 
for _ in range(t):
    s = input().strip()
 
    dp0 = 0                    # only 2's
    dp1 = -10**18              # 2*(1|3)*
 
    for c in s:
        if c == '2':
            dp0 += 1
        elif c == '1' or c == '3':
            dp1 = max(dp1 + 1, dp0 + 1)
        # c == '4' : cannot be taken
 
    keep = max(dp0, dp1)
    print(len(s) - keep)
