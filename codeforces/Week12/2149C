import sys
 
data = list(map(int, sys.stdin.buffer.read().split()))
idx = 0
 
t = data[idx]
idx += 1
 
ans_list = []
 
for _ in range(t):
    n = data[idx]
    k = data[idx + 1]
    idx += 2
 
    seen = [False] * k
    missing = k
    cnt_k = 0
 
    for _ in range(n):
        x = data[idx]
        idx += 1
 
        if x < k:
            if not seen[x]:
                seen[x] = True
                missing -= 1
        elif x == k:
            cnt_k += 1
 
    ans_list.append(str(max(missing, cnt_k)))
 
print('\n'.join(ans_list))
