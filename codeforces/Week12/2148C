import sys
 
input = sys.stdin.readline
 
t = int(input())
 
for _ in range(t):
    n, m = map(int, input().split())
 
    ans = 0
    prev_a = 0
    prev_b = 0   # 처음 위치는 side 0
 
    for _ in range(n):
        a, b = map(int, input().split())
 
        d = a - prev_a          # 현재 구간의 시간 길이
        need = prev_b ^ b       # 위치가 바뀌어야 하면 1, 같아야 하면 0
 
        if d % 2 == need:
            ans += d
        else:
            ans += d - 1
 
        prev_a = a
        prev_b = b
 
    # 마지막 요구 이후에는 조건이 없으므로 전부 달릴 수 있음
    ans += m - prev_a
 
    print(ans)
